APP_MODE=paper

# Ollama Cloud only. No local Ollama fallback is used by this application.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=

STARTING_CASH=500
MAX_POSITION_PCT=0.50
MAX_DAILY_LOSS_PCT=0.05
MAX_OPEN_POSITIONS=3
MIN_BUY_CONFIDENCE=0.60
PAPER_SLIPPAGE_BPS=5
DATA_DIR=/var/lib/ai-stock-trading
RUNTIME_POLL_SECONDS=10
DASHBOARD_PORT=8080
DASHBOARD_ADMIN_TOKEN=

# Leave empty for production-style dynamic NSE cash-equity discovery.
# Set a comma-separated list only to deliberately constrain the mandate.
TRADING_WATCHLIST=
DECISION_INTERVAL_SECONDS=900
QUOTE_POLL_SECONDS=10
MAX_AI_CANDIDATES=5

# Daily post-close academic discovery. SSRN metadata is retrieved through Crossref;
# newly discovered papers cannot influence trading until a hypothesis is explicitly accepted.
ACADEMIC_RESEARCH_ENABLED=true
ACADEMIC_RESEARCH_REFRESH_HOURS=24
ACADEMIC_RESEARCH_ROWS_PER_TOPIC=8
ACADEMIC_RESEARCH_LOOKBACK_DAYS=3650
ACADEMIC_RESEARCH_MAILTO=
ACADEMIC_RESEARCH_TOPICS=Indian equities momentum market regime;NSE intraday momentum transaction costs;equity order book imbalance market microstructure;volatility adjusted position sizing momentum;breakout pullback entry momentum

UNIVERSE_HISTORY_DAYS=90
UNIVERSE_MIN_PRICE=20
UNIVERSE_MIN_HISTORY_BARS=20
UNIVERSE_MIN_AVG_TRADED_VALUE=50000000
UNIVERSE_SCAN_LIMIT=100

# LIVE MODE SAFETY: leave these disabled for paper/backtest deployments.
LIVE_TRADING_ARMED=false
LIVE_TRADING_CONFIRMATION=

# Zerodha Kite Connect. These can also be entered through the secured dashboard setup form.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Session token is short-lived and expires at 6 AM the next day.
ZERODHA_ACCESS_TOKEN=
LIVE_ORDER_TIMEOUT_SECONDS=120
