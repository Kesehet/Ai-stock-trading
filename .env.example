APP_MODE=paper
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:120b
STARTING_CASH=500000
MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.01
MAX_OPEN_POSITIONS=10
DATA_DIR=/var/lib/ai-stock-trading
RUNTIME_POLL_SECONDS=10
DASHBOARD_PORT=8080

# Autonomous fund. Leave PAPER_UNIVERSE empty to auto-discover the full NSE EQ
# universe and deterministically screen/rank it before deep AI research.
# Set a comma-separated list only when intentionally constraining the mandate.
PAPER_UNIVERSE=
PAPER_CYCLE_SECONDS=900
PAPER_HISTORY_DAYS=90
PAPER_FALLBACK_MOMENTUM=true
PAPER_FALLBACK_TARGET_PCT=0.03

# Dynamic NSE universe controls. These apply to the common fund engine and are
# intentionally suitable for both paper and future live execution.
UNIVERSE_CANDIDATE_LIMIT=75
UNIVERSE_MIN_PRICE=20
UNIVERSE_MIN_HISTORY_BARS=20
UNIVERSE_MIN_AVG_TRADED_VALUE=50000000

# LIVE MODE SAFETY: leave these disabled for paper/backtest deployments.
LIVE_TRADING_ARMED=false
LIVE_TRADING_CONFIRMATION=

# Zerodha Kite Connect. Inject these as server-side secrets; never commit real values.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Session token is short-lived and expires at 6 AM the next day.
ZERODHA_ACCESS_TOKEN=
